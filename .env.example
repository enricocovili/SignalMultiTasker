# Copy to .env and fill in. .env is gitignored; never commit real values.

# ── Email (IMAP, imap.hostinger.com) ──────────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=

# ── Signal ────────────────────────────────────────────────────────────────────
# SIGNAL_SENDER is the phone number of the account this bridge links to.
# SIGNAL_GROUP_ID includes the "group." prefix.
SIGNAL_SENDER=
SIGNAL_GROUP_ID=

# ── LLM summariser (OpenAI-compatible chat completions) ───────────────────────
# LLM_URL is the API base ending in /v1; the bridge appends /chat/completions.
# Without a working provider the bridge still forwards emails, as a plain
# excerpt instead of a summary.
LLM_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Speech-to-text (OpenAI-compatible audio transcriptions) ───────────────────
# WHISPER_URL is the API base; the bridge appends /audio/transcriptions.
# Required for voice-message handling. May be the same provider and key as
# above — set both if so.
WHISPER_URL=https://api.openai.com/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
# Empty = auto-detect the spoken language (e.g. it, en).
WHISPER_LANG=
