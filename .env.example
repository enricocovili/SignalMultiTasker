# Copy to .env and fill in. .env is gitignored; never commit real values.

# ── Email (IMAP, imap.hostinger.com) ──────────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=

# ── Signal ────────────────────────────────────────────────────────────────────
# SIGNAL_SENDER is the phone number of the account this bridge links to.
# SIGNAL_GROUP_ID includes the "group." prefix.
SIGNAL_SENDER=
SIGNAL_GROUP_ID=

# ── LLM summariser (OpenAI-compatible chat completions) ───────────────────────
# LLM_URL is the API base ending in /v1; the bridge appends /chat/completions.
# Without a working provider the bridge still forwards emails, as a plain
# excerpt instead of a summary.
LLM_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Speech-to-text (OpenAI-compatible audio transcriptions) ───────────────────
# WHISPER_URL is the API base; the bridge appends /audio/transcriptions.
# Required for voice-message handling. May be the same provider and key as
# above — set both if so.
WHISPER_URL=https://api.openai.com/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
# Empty = auto-detect the spoken language (e.g. it, en). Some providers
# translate to English on auto-detect instead of transcribing verbatim.
WHISPER_LANG=it

# ── Voice-note whitelist ──────────────────────────────────────────────────────
# Comma-separated chats whose voice notes are transcribed + summarised: group
# IDs with the "group." prefix and/or phone numbers (+39...) for 1:1 chats.
# Voice notes elsewhere are ignored (and logged, so you can copy the ID).
# Empty = only SIGNAL_GROUP_ID. Setting it REPLACES that fallback, so list
# SIGNAL_GROUP_ID again if its group should keep working. Group IDs:
#   GET /v1/groups/<SIGNAL_SENDER> on signal-api (use the "id" field).
VOICE_ALLOWED_CHATS=

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
